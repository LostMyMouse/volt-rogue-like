{
 "gravemark_54602e44": {
  "who": "gravemark",
  "text": "And any heroes who object can take it up with me. On the roof.",
  "model": "eleven_v4",
  "voice_id": "UrBeqP9db3vlQVM3Tmfu",
  "sha256": "e97eee8f782b317facbfcd0b9e6723639363979f41443eee3cdd9edaf76b3482"
 },
 "bastion_7fc38a62": {
  "who": "bastion",
  "text": "Four districts dark. Half my roster drained. Somebody give me good news.",
  "model": "eleven_v4",
  "voice_id": "SRAtZ2ZOED030czOR8WQ",
  "sha256": "8d7e9d007f3e774d001ac90a6a9c578b228ea1c4d00f9519f3a4d4d1ffff51fc"
 },
 "patch_716b0bc7": {
  "who": "patch",
  "text": "Good news: the coffee machine survived.",
  "model": "eleven_v4",
  "voice_id": "Xb7hH8MSUJpSbSDYk0k2",
  "sha256": "5c772141f72477ce62f3143de211deb71aaaae3e40dfac46e14f5d18ccf72f4d"
 },
 "bastion_decf2519": {
  "who": "bastion",
  "text": "Patch.",
  "model": "eleven_v4",
  "voice_id": "SRAtZ2ZOED030czOR8WQ",
  "sha256": "ec8ffe12bb85fdb62d8e544cacfcb93365bb8b13af0d354d976d2f0dffb5ba31"
 },
 "patch_67bb8f29": {
  "who": "patch",
  "text": "Bad news: so did the Redactor.",
  "model": "eleven_v4",
  "voice_id": "Xb7hH8MSUJpSbSDYk0k2",
  "sha256": "b12f04db174a6e84774eb62a22c6fd213ab2cb136f71e02dfad2f0531271b389"
 },
 "echo_115191c1": {
  "who": "echo",
  "text": "Can we skip to the part where I'm right? We need more people.",
  "model": "eleven_v4",
  "voice_id": "Y5YV8HtWsJXkknTppIP7",
  "sha256": "a136400ae71d85a566bdd11993d9f7d15e393cd761e8e61177b3bf59e9bc69d5"
 },
 "thorn_bd7413fd": {
  "who": "thorn",
  "text": "People who aren't scared of him. That's a short list.",
  "model": "eleven_v4",
  "voice_id": "nPczCjzI2devNBz1zQrb",
  "sha256": "3de90ca25a88013e8473794258f3dbdf90e361966fb97dc7fdad8720fde48665"
 },
 "halo_956fc1b8": {
  "who": "halo",
  "text": "Then we make it longer.",
  "model": "eleven_v4",
  "voice_id": "pFZP5JQG7iQjIQuC4Bku",
  "sha256": "d2ff3506923c18a54376f4cd80eaef0a7eeb68f6d08b923bb8ad06730519e11d"
 },
 "patch_b3fde7be": {
  "who": "patch",
  "text": "Uh. Small thing. Someone's climbing the outside of the Fortress.",
  "model": "eleven_v4",
  "voice_id": "Xb7hH8MSUJpSbSDYk0k2",
  "sha256": "bb87e57d34192f38e92b1181478f82c6621eb43fc047bb50d807fbf4ee98b9ff"
 },
 "bastion_e7522979": {
  "who": "bastion",
  "text": "Nobody climbs a sixty-storey wall.",
  "model": "eleven_v4",
  "voice_id": "SRAtZ2ZOED030czOR8WQ",
  "sha256": "21d19b613f54ffa47266fc5d8f31e496ba986d11a621b25126b7fed2a079d5b0"
 },
 "volt_575d0d54": {
  "who": "volt",
  "text": "Hi! Sorry. Your front door has, like, nine locks.",
  "model": "eleven_v4",
  "voice_id": "RmtUVKbwMJFKYraSJIVs",
  "sha256": "12dea4c843412791d9fb3ab9a3e59d929ba1f12ff0040a475f7639d59198fbd0"
 },
 "volt_8b642679": {
  "who": "volt",
  "text": "I'm Volt. I'm a hero. Well... rookie hero. I saw the broadcast, and I want to help.",
  "model": "eleven_v4",
  "voice_id": "RmtUVKbwMJFKYraSJIVs",
  "sha256": "1bed901bf3368e218b6f4e513817606a163e0901f09d485a937c6dcac849782f"
 },
 "echo_6c8d6193": {
  "who": "echo",
  "text": "Oh, I like him.",
  "model": "eleven_v4",
  "voice_id": "Y5YV8HtWsJXkknTppIP7",
  "sha256": "94a54e3afb67ee98c58c7208bbcfd796e456f865ab73671dbd6e53b4c345b642"
 },
 "halo_58358912": {
  "who": "halo",
  "text": "You're bleeding.",
  "model": "eleven_v4",
  "voice_id": "pFZP5JQG7iQjIQuC4Bku",
  "sha256": "9b8e440bf34aed4a972f75c9743c8066c5796cf05f83cdff981b8d3fe56805d8"
 },
 "volt_c3b5a289": {
  "who": "volt",
  "text": "The wall had opinions.",
  "model": "eleven_v4",
  "voice_id": "RmtUVKbwMJFKYraSJIVs",
  "sha256": "0569eb6f0894bac8bdb007764957dc354f75c02ce5b663880d21e12b7e54c9f2"
 },
 "halo_9b908412": {
  "who": "halo",
  "text": "Bastion. Give the rookie a run.",
  "model": "eleven_v4",
  "voice_id": "pFZP5JQG7iQjIQuC4Bku",
  "sha256": "ec444221f5e41d59a68c34051c39cc002a9c07c080a9eceba7cd2dce5fdbfb98"
 },
 "bastion_705207b3": {
  "who": "bastion",
  "text": "Training roof. Now. Let's see what you've actually got.",
  "model": "eleven_v4",
  "voice_id": "SRAtZ2ZOED030czOR8WQ",
  "sha256": "3c1f3fe8dc7c8301171b1e11d5f3db2539c9c7d9f261482113b87109f8f3d5a7"
 },
 "volt_2075047c": {
  "who": "volt",
  "text": "Right now? I just climbed sixty floors.",
  "model": "eleven_v4",
  "voice_id": "RmtUVKbwMJFKYraSJIVs",
  "sha256": "fba9e4824dac59bc4ac992061b879e2c006ca467283e91cea4a44834689d28a3"
 },
 "halo_9174fefa": {
  "who": "halo",
  "text": "Halo on comms. So you're the rookie everyone keeps talking about.",
  "model": "eleven_v4",
  "voice_id": "pFZP5JQG7iQjIQuC4Bku",
  "sha256": "073e84fc72979dbf43fe5f47d185c5febff5e2b2066a23135833af82a4e91f1a"
 },
 "volt_bd434882": {
  "who": "volt",
  "text": "Halo? THE Halo? Okay. Okay. Be cool. I'm being cool.",
  "model": "eleven_v4",
  "voice_id": "RmtUVKbwMJFKYraSJIVs",
  "sha256": "ab8dcf86cf71ba2ac13e053c9795d9763bafc7cc458c74f1f84ae2ed398c68ab"
 },
 "halo_4121158e": {
  "who": "halo",
  "text": "You're narrating.",
  "model": "eleven_v4",
  "voice_id": "pFZP5JQG7iQjIQuC4Bku",
  "sha256": "d6dd1246fcf91c22f28a627ba50f8c4bac8671c6273edf3b89948364b0368328"
 },
 "volt_5efd5bc0": {
  "who": "volt",
  "text": "...Yep.",
  "model": "eleven_v4",
  "voice_id": "RmtUVKbwMJFKYraSJIVs",
  "sha256": "9f7ed7bf3ec241d0b0d5ea68aced87e2b8ef532d0ae1a6159cea1f1448274df8"
 },
 "bastion_1a33bf07": {
  "who": "bastion",
  "text": "Bastion. I hold this city's line. Tonight, I'm holding yours.",
  "model": "eleven_v4",
  "voice_id": "SRAtZ2ZOED030czOR8WQ",
  "sha256": "1be1b89c64a6c5527f2b4ef4f75d0c43f0ea2c32063513ae7d44431e44c13e96"
 },
 "volt_b6cb499b": {
  "who": "volt",
  "text": "Cool. Great. I'll hold... a different line.",
  "model": "eleven_v4",
  "voice_id": "RmtUVKbwMJFKYraSJIVs",
  "sha256": "b4469ed475a6a5779bf5396bfae2fd274f63a8cd55edbea65dc7835f11c8d77d"
 },
 "bastion_9c4164aa": {
  "who": "bastion",
  "text": "Just hold still and take the gear.",
  "model": "eleven_v4",
  "voice_id": "SRAtZ2ZOED030czOR8WQ",
  "sha256": "12c2155798a661543236a5590157d225052f270e60167cd74d33a2ca36c8cb36"
 },
 "echo_677de98a": {
  "who": "echo",
  "text": "Echo. And before you say anything, I already know how tonight ends.",
  "model": "eleven_v4",
  "voice_id": "Y5YV8HtWsJXkknTppIP7",
  "sha256": "677ac8e0f0eaf136bca61d72ecddd37ef64bd086fcfba9e5f818f135741949ec"
 },
 "volt_8b45ae34": {
  "who": "volt",
  "text": "Do you, though?",
  "model": "eleven_v4",
  "voice_id": "RmtUVKbwMJFKYraSJIVs",
  "sha256": "5e2bf5026a79268908fea4fd06d73a224e7b24b32922a62200de2cf678e5811d"
 },
 "echo_b4432418": {
  "who": "echo",
  "text": "...Mostly.",
  "model": "eleven_v4",
  "voice_id": "Y5YV8HtWsJXkknTppIP7",
  "sha256": "8132cfa4b07b3a52755157f0f0cb4234fcc4e8ed100023688b77fb33a6e46093"
 },
 "thorn_e8741fb6": {
  "who": "thorn",
  "text": "Thorn. I used to be on the other side.",
  "model": "eleven_v4",
  "voice_id": "nPczCjzI2devNBz1zQrb",
  "sha256": "ea15f2c2c80970a12ce4cfb83053807b9f6e3be9f661aff6ef3767833d766d63"
 },
 "volt_5986ad5a": {
  "who": "volt",
  "text": "Glad you switched.",
  "model": "eleven_v4",
  "voice_id": "RmtUVKbwMJFKYraSJIVs",
  "sha256": "f4b07bf9e8dca7eaaa6333e9822c7a241f4c660d2a552ec44bb1103bcb369f31"
 },
 "thorn_bc360c3e": {
  "who": "thorn",
  "text": "Some days, so am I.",
  "model": "eleven_v4",
  "voice_id": "nPczCjzI2devNBz1zQrb",
  "sha256": "387bd652e0a0e0283b64b44c309f8f711553c8b638963c8395bcd3636d025544"
 },
 "patch_94156648": {
  "who": "patch",
  "text": "Patch. I build the gear. You break the gear.",
  "model": "eleven_v4",
  "voice_id": "Xb7hH8MSUJpSbSDYk0k2",
  "sha256": "01d508ce02fd89240feaaec43b5d6f5704b5d5163cab0c9b135eaaf002ecc705"
 },
 "volt_ed27beb9": {
  "who": "volt",
  "text": "I'll try to break it less.",
  "model": "eleven_v4",
  "voice_id": "RmtUVKbwMJFKYraSJIVs",
  "sha256": "91eef8a0f54924b67e0608daf2b0ca5451939b508bcec5455acf41c8c5e3c760"
 },
 "patch_0d0119b6": {
  "who": "patch",
  "text": "You won't. But I appreciate the lie.",
  "model": "eleven_v4",
  "voice_id": "Xb7hH8MSUJpSbSDYk0k2",
  "sha256": "f2c7bd5cf5b90512e4412d7015975f636b3f426de77a2c0faf5566494e3a90a0"
 },
 "kilnheart_947f7ebe": {
  "who": "kilnheart",
  "text": "Whoa, whoa. Hold up. You're the new kid? They sent the new kid?",
  "model": "eleven_v4",
  "voice_id": "yWRPuhQv7d5rFyrtj0GI",
  "sha256": "c6ff55c60d7003993d6195d94fc7b7fd0895930d97fb3621eaa28b3e7d996eac"
 },
 "volt_04b6b6da": {
  "who": "volt",
  "text": "I prefer 'rookie'. Sounds more official.",
  "model": "eleven_v4",
  "voice_id": "RmtUVKbwMJFKYraSJIVs",
  "sha256": "d53424aa8d21ed3926daf56803d469cb812c1a150178c37131383a1ee58a2624"
 },
 "kilnheart_2f0a5646": {
  "who": "kilnheart",
  "text": "Kid, I've been running furnaces since before you had teeth. You know what happens to things that get too close to the fire?",
  "model": "eleven_v4",
  "voice_id": "yWRPuhQv7d5rFyrtj0GI",
  "sha256": "ef11feaa48e1646c3b26a20c6ee3c8c917174fe608a78f8854b2d8ad2ee7c8f4"
 },
 "volt_bcdc65d0": {
  "who": "volt",
  "text": "They... get warm?",
  "model": "eleven_v4",
  "voice_id": "RmtUVKbwMJFKYraSJIVs",
  "sha256": "32bd8c14c9b9c403e43c6e0b3638d91e7dc4a84d975d0a65f3a949eb8aef570b"
 },
 "kilnheart_fc8c2edc": {
  "who": "kilnheart",
  "text": "They get warm.",
  "model": "eleven_v4",
  "voice_id": "yWRPuhQv7d5rFyrtj0GI",
  "sha256": "b71700f6f8ae4358d355a1910994b7fd17366520a78dbc0d03870d1ee67e4398"
 },
 "bellwether_0942764c": {
  "who": "bellwether",
  "text": "Oh, finally. An audience.",
  "model": "eleven_v4",
  "voice_id": "AJuNP3sFJckEVT7VAAqm",
  "sha256": "944d4addb8d212e78b1f9e8096c849c7723517c80719909e9613637ac6a69953"
 },
 "volt_43f97db5": {
  "who": "volt",
  "text": "I'm here to stop you.",
  "model": "eleven_v4",
  "voice_id": "RmtUVKbwMJFKYraSJIVs",
  "sha256": "3f66027c7e9a347fca293597e7843b565425a08b8d02ec6e5dadcda0a30deafe"
 },
 "bellwether_d24ec151": {
  "who": "bellwether",
  "text": "Everyone says that before the first song. Nobody says it after the encore.",
  "model": "eleven_v4",
  "voice_id": "AJuNP3sFJckEVT7VAAqm",
  "sha256": "cc65bc03b172b66d8a523d44f7f77f05887e89d1fda70c42613c76cd78605f32"
 },
 "volt_4f2d146b": {
  "who": "volt",
  "text": "Is it a long set?",
  "model": "eleven_v4",
  "voice_id": "RmtUVKbwMJFKYraSJIVs",
  "sha256": "d745d7b19360735caff3363a734a3e51cc07b20d68fdbd670d005c71a4414da7"
 },
 "bellwether_1efd3a16": {
  "who": "bellwether",
  "text": "Darling, it's a residency.",
  "model": "eleven_v4",
  "voice_id": "AJuNP3sFJckEVT7VAAqm",
  "sha256": "7bc8275636377f24bb68892ed365769d10d344bec438bd77e9c0976095eb7af8"
 },
 "verdigris_c0fd776b": {
  "who": "verdigris",
  "text": "Mind the vines. They bite. Well. They don't bite. They just never let go.",
  "model": "eleven_v4",
  "voice_id": "5PhA4LJ8zKeDCb1ZxraK",
  "sha256": "aca7d5da4de6081944869df1da08d71e85c73274e6d40c8f1fbd9a804648779a"
 },
 "volt_49d7ebeb": {
  "who": "volt",
  "text": "That's somehow worse.",
  "model": "eleven_v4",
  "voice_id": "RmtUVKbwMJFKYraSJIVs",
  "sha256": "36246362e92269b21ea1d01e11612c37ed4a9e33f86b15ff12b0d4cc7eab9559"
 },
 "verdigris_85882746": {
  "who": "verdigris",
  "text": "Everything on this roof is slowly becoming mine. The pipes. The rails. You, if you stand still long enough.",
  "model": "eleven_v4",
  "voice_id": "5PhA4LJ8zKeDCb1ZxraK",
  "sha256": "64c6f1a1cdf381fb02d2aa6c575ea92c52051e79923914eaf04c037c246c1891"
 },
 "volt_2cc3736b": {
  "who": "volt",
  "text": "Noted. Moving a lot. Got it.",
  "model": "eleven_v4",
  "voice_id": "RmtUVKbwMJFKYraSJIVs",
  "sha256": "b05b8cbde9943a43cee004bb01de87116a646c4bd0b94780a94d7c5aced1087d"
 },
 "glasswake_90cf841f": {
  "who": "glasswake",
  "text": "Hi. Over here. No, over here. No, you know what? Pick one. I'll wait.",
  "model": "eleven_v4",
  "voice_id": "cgSgspJ2msm6clMCkdW9",
  "sha256": "faf59a7fac0f9b66574adddf7878ee10b8f14ea68671d9bb106e982c1dcd5fd4"
 },
 "volt_a47c2c59": {
  "who": "volt",
  "text": "How about I just hit all of you?",
  "model": "eleven_v4",
  "voice_id": "RmtUVKbwMJFKYraSJIVs",
  "sha256": "3c445781def047233ef7a5e9c2bf4a0bbf6e65a8070a789cd2a609cf02c30107"
 },
 "glasswake_137f68b9": {
  "who": "glasswake",
  "text": "Ooh. Bold. Wrong, but bold.",
  "model": "eleven_v4",
  "voice_id": "cgSgspJ2msm6clMCkdW9",
  "sha256": "6a1952dc99049596132c20d28a5964dcc35c538838333bcd559f80ecd2e4fdcb"
 },
 "undertow_e3048d54": {
  "who": "undertow",
  "text": "Picked a bad night to go swimming, rookie.",
  "model": "eleven_v4",
  "voice_id": "urczK0YCwtnTeJkvb4PB",
  "sha256": "98a89d54d5b0fbf70037a3db8bf4a202756a3c7c913431672f0dfeb67923b1d9"
 },
 "volt_471d6900": {
  "who": "volt",
  "text": "I didn't really pick it. I kind of just... landed here.",
  "model": "eleven_v4",
  "voice_id": "RmtUVKbwMJFKYraSJIVs",
  "sha256": "924ed3039c053ac6219e0e0f43c55f36728f87e2f860d1377552907758b290a5"
 },
 "undertow_f7519dd3": {
  "who": "undertow",
  "text": "Story of this whole district. Nobody chooses the docks. The docks choose you.",
  "model": "eleven_v4",
  "voice_id": "urczK0YCwtnTeJkvb4PB",
  "sha256": "29c9663ff418e29df40aa2549ce4418d7a6a78f5c1c33296aa3d7fbd5ec97603"
 },
 "gravemark_48d7cd1a": {
  "who": "gravemark",
  "text": "Another one.",
  "model": "eleven_v4",
  "voice_id": "UrBeqP9db3vlQVM3Tmfu",
  "sha256": "142a4919ae6868372667a8c480f9100b7f654851de3c87519ae0fb7c0539e543"
 },
 "volt_4eb048aa": {
  "who": "volt",
  "text": "Another... what?",
  "model": "eleven_v4",
  "voice_id": "RmtUVKbwMJFKYraSJIVs",
  "sha256": "8439a0753cb8f0c257133f6c01f998b30150e12857cac1154547366cceec687f"
 },
 "gravemark_d20d04df": {
  "who": "gravemark",
  "text": "Another small, loud hero on my roof. I have carved forty-one names. Yours will be forty-two.",
  "model": "eleven_v4",
  "voice_id": "UrBeqP9db3vlQVM3Tmfu",
  "sha256": "378df1b619e1e0f342c3627cda90b6f39a86b8dadc0cb4c00a3d48a10167ceda"
 },
 "volt_43ca42be": {
  "who": "volt",
  "text": "Can you at least spell it right? It's V-O-L-T.",
